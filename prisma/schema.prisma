generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccessRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  DISABLED
}

enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum FeedbackStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum QuestionType {
  RATING
  LONG_TEXT
  SHORT_TEXT
}

// Estrutura organizacional
model Company {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(160)
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  departments Department[]
  people      Person[]

  @@map("companies")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  people    Person[]

  @@unique([companyId, name])
  @@index([companyId, active])
  @@map("departments")
}

model Person {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  departmentId       String                 @map("department_id") @db.Uuid
  managerId          String?                @map("manager_id") @db.Uuid
  fullName           String                 @map("full_name") @db.VarChar(200)
  corporateEmail     String?                @map("corporate_email") @db.VarChar(254)
  jobTitle           String                 @map("job_title") @db.VarChar(160)
  employmentRegime   String                 @map("employment_regime") @db.VarChar(80)
  active             Boolean                @default(true)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager            Person?                @relation("PersonHierarchy", fields: [managerId], references: [id], onDelete: Restrict)
  directReports      Person[]               @relation("PersonHierarchy")
  account            AccessAccount?
  feedbacksReceived  Feedback[]             @relation("FeedbackSubject")
  feedbacksGiven     Feedback[]             @relation("FeedbackEvaluator")
  managerHistory     ReportingLineHistory[] @relation("HistoryManager")
  subordinateHistory ReportingLineHistory[] @relation("HistorySubordinate")

  @@index([companyId, active])
  @@index([departmentId, active])
  @@index([managerId, active])
  @@index([corporateEmail])
  @@map("people")
}

// Identidade, papéis e sessões
model AccessAccount {
  id                 String                  @id @default(uuid()) @db.Uuid
  personId           String                  @unique @map("person_id") @db.Uuid
  loginIdentifier    String                  @map("login_identifier") @db.VarChar(190)
  passwordHash       String                  @map("password_hash") @db.VarChar(255)
  status             AccountStatus           @default(PENDING_ACTIVATION)
  mustChangePassword Boolean                 @default(true) @map("must_change_password")
  failedLoginCount   Int                     @default(0) @map("failed_login_count")
  lockedUntil        DateTime?               @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt  DateTime?               @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?               @map("last_login_at") @db.Timestamptz(3)
  sessionVersion     Int                     @default(1) @map("session_version")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  person             Person                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  roles              AccountRoleAssignment[]
  sessions           UserSession[]
  auditEvents        AuditEvent[]
  hierarchyChanges   ReportingLineHistory[]  @relation("HistoryChangedBy")

  @@index([status])
  @@index([loginIdentifier])
  @@map("access_accounts")
}

model AccountRoleAssignment {
  accountId String        @map("account_id") @db.Uuid
  role      AccessRole
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  account   AccessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, role])
  @@map("account_role_assignments")
}

model UserSession {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @map("account_id") @db.Uuid
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  account   AccessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("user_sessions")
}

model ReportingLineHistory {
  id                 String         @id @default(uuid()) @db.Uuid
  subordinateId      String         @map("subordinate_id") @db.Uuid
  managerId          String?        @map("manager_id") @db.Uuid
  changedByAccountId String?        @map("changed_by_account_id") @db.Uuid
  validFrom          DateTime       @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil         DateTime?      @map("valid_until") @db.Timestamptz(3)
  reason             String?        @db.VarChar(240)
  subordinate        Person         @relation("HistorySubordinate", fields: [subordinateId], references: [id], onDelete: Restrict)
  manager            Person?        @relation("HistoryManager", fields: [managerId], references: [id], onDelete: Restrict)
  changedBy          AccessAccount? @relation("HistoryChangedBy", fields: [changedByAccountId], references: [id], onDelete: SetNull)

  @@index([subordinateId, validUntil])
  @@index([managerId, validUntil])
  @@map("reporting_line_history")
}

// Ciclos e formulários
model Cycle {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String              @db.VarChar(160)
  startsAt              DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime            @map("ends_at") @db.Timestamptz(3)
  status                CycleStatus         @default(DRAFT)
  selfAssessmentEnabled Boolean             @default(false) @map("self_assessment_enabled")
  version               Int                 @default(1)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  feedbacks             Feedback[]
  cycleTemplates        CycleFormTemplate[]

  @@index([status, startsAt, endsAt])
  @@map("cycles")
}

model FormTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(160)
  version        Int
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  questions      FormQuestion[]
  cycleTemplates CycleFormTemplate[]

  @@unique([name, version])
  @@map("form_templates")
}

model FormQuestion {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @map("template_id") @db.Uuid
  prompt     String           @db.VarChar(1000)
  type       QuestionType
  position   Int
  required   Boolean          @default(true)
  minimum    Int?
  maximum    Int?
  active     Boolean          @default(true)
  template   FormTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  answers    FeedbackAnswer[]

  @@unique([templateId, position])
  @@map("form_questions")
}

model CycleFormTemplate {
  cycleId    String       @map("cycle_id") @db.Uuid
  templateId String       @map("template_id") @db.Uuid
  cycle      Cycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@id([cycleId, templateId])
  @@map("cycle_form_templates")
}

// Feedbacks e trilha de auditoria
model Feedback {
  id                String           @id @default(uuid()) @db.Uuid
  cycleId           String           @map("cycle_id") @db.Uuid
  subjectPersonId   String           @map("subject_person_id") @db.Uuid
  evaluatorPersonId String           @map("evaluator_person_id") @db.Uuid
  status            FeedbackStatus   @default(DRAFT)
  submittedAt       DateTime?        @map("submitted_at") @db.Timestamptz(3)
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  cycle             Cycle            @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  subject           Person           @relation("FeedbackSubject", fields: [subjectPersonId], references: [id], onDelete: Restrict)
  evaluator         Person           @relation("FeedbackEvaluator", fields: [evaluatorPersonId], references: [id], onDelete: Restrict)
  answers           FeedbackAnswer[]

  @@unique([cycleId, subjectPersonId, evaluatorPersonId])
  @@index([subjectPersonId, status])
  @@index([evaluatorPersonId, status])
  @@map("feedbacks")
}

model FeedbackAnswer {
  id         String       @id @default(uuid()) @db.Uuid
  feedbackId String       @map("feedback_id") @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  rating     Int?
  text       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  feedback   Feedback     @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([feedbackId, questionId])
  @@map("feedback_answers")
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  actorAccountId String?        @map("actor_account_id") @db.Uuid
  requestId      String         @map("request_id") @db.VarChar(80)
  action         String         @db.VarChar(120)
  entityType     String         @map("entity_type") @db.VarChar(80)
  entityId       String?        @map("entity_id") @db.Uuid
  result         String         @db.VarChar(40)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          AccessAccount? @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)

  @@index([actorAccountId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}
